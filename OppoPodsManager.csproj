<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform backend: RID if set, else host OS; force with /p:EnableWindowsBackend=true.
       Evaluated before TargetFramework so Windows TFM (WinRT/BLE) can be selected. -->
  <PropertyGroup>
    <EnableWindowsBackend Condition="'$(EnableWindowsBackend)' == '' and $(RuntimeIdentifier.StartsWith('win'))">true</EnableWindowsBackend>
    <EnableWindowsBackend Condition="'$(EnableWindowsBackend)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsBackend>
    <EnableWindowsBackend Condition="'$(EnableWindowsBackend)' == ''">false</EnableWindowsBackend>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows backend uses Windows TFM for WinRT (Windows.Devices.Bluetooth GATT).
         Other platforms stay on plain net10.0 for future Linux/macOS backends. -->
    <TargetFramework Condition="'$(EnableWindowsBackend)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(EnableWindowsBackend)' != 'true'">net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <RootNamespace>OppoPodsManager</RootNamespace>
    <AssemblyName>OppoPodsManager</AssemblyName>
    <!-- Single version source of truth. -->
    <Version>1.1.8</Version>
    <ApplicationIcon>Assets\tuopan.ico</ApplicationIcon>
    <SupportedOSPlatformVersion Condition="'$(EnableWindowsBackend)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <NoWarn>CA1416;AVLN3001</NoWarn>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <!-- Debug: keep symbols, no AOT/self-contained -->
    <SelfContained Condition="'$(Configuration)' != 'Release'">false</SelfContained>
  </PropertyGroup>

  <!-- Release/AOT publish -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Linux define + disable AOT on non-Windows (Tmds.DBus needs dynamic code) -->
  <PropertyGroup Condition="'$(EnableWindowsBackend)' != 'true'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(EnableWindowsBackend)' != 'true'">
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableWindowsBackend)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableWindowsBackend)' != 'true'">
    <Compile Remove="Transport\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableWindowsBackend)' == 'true'">
    <Compile Remove="Transport\Linux\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Core\**\*.cs" />
    <Compile Remove="Application\**\*.cs" />
    <Compile Remove="Platforms\**\*.cs" />
    <Compile Remove="Brands\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Abstractions/**/*.cs" />
    <Compile Remove="Codec/**/*.cs" />
    <Compile Remove="Models/**/*.cs" />
    <Compile Remove="Protocol/**/*.cs" />
    <Compile Remove="Services/**/*.cs" />
    <Compile Remove="Transport/**/*.cs" />
    <Compile Remove="Util/**/*.cs" />
    <Compile Remove="Localization/**/*.cs" />
    <Compile Remove="Views/**/*.cs" />
    <Compile Remove="Data/**/*.cs" />
    <Compile Remove="Network/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Brands\Oppo\Resources\DeviceModels.json" />
    <None Remove="Brands\Oppo\Resources\EqModeNames.json" />
    <None Remove="Brands\Oppo\Resources\EqModeNames.en.json" />
    <None Remove="Brands\Oppo\Resources\EqModeNames.ru.json" />
    <None Remove="Brands\Oppo\Resources\EqModeNames.de.json" />
    <EmbeddedResource Include="Brands\Oppo\Resources\DeviceModels.json" LogicalName="OppoPodsManager.DeviceModels.json" />
    <EmbeddedResource Include="Brands\Oppo\Resources\EqModeNames.json" LogicalName="OppoPodsManager.EqModeNames.json" />
    <EmbeddedResource Include="Brands\Oppo\Resources\EqModeNames.en.json" LogicalName="OppoPodsManager.EqModeNames.en.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Brands\Oppo\Resources\EqModeNames.ru.json" LogicalName="OppoPodsManager.EqModeNames.ru.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
    <EmbeddedResource Include="Brands\Oppo\Resources\EqModeNames.de.json" LogicalName="OppoPodsManager.EqModeNames.de.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="App\Infrastructure\Localization\**\*.json" />
    <EmbeddedResource Include="App\Infrastructure\Localization\**\*.json">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(EnableWindowsBackend)' != 'true'">
    <PackageReference Include="Tmds.DBus" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Irihi.Lingua" />
    <PackageReference Include="SukiUI" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Core\OppoPodsManager.Core.csproj" />
    <ProjectReference Include="Application\OppoPodsManager.Application.csproj" />
    <ProjectReference Include="Platforms\OppoPodsManager.Platforms.csproj" />
    <ProjectReference Include="Brands\Oppo\OppoPodsManager.Brands.csproj" />
  </ItemGroup>

  <Target Name="RemovePdbAfterPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishDir Condition="'$(PublishDir)' == ''">$(OutputPath)$(Platform)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</_PublishDir>
      <_PublishDir Condition="'$(PublishDir)' != ''">$(PublishDir)</_PublishDir>
      <_PublishDir Condition="!HasTrailingSlash('$(_PublishDir)')">$(_PublishDir)\</_PublishDir>
    </PropertyGroup>
    <Exec Condition="$([MSBuild]::IsOSPlatform('Windows'))" Command="del /f /q &quot;$(_PublishDir)*.pdb&quot;" IgnoreExitCode="true" />
    <Exec Condition="!$([MSBuild]::IsOSPlatform('Windows'))" Command="rm -f &quot;$(_PublishDir)*.pdb&quot;" IgnoreExitCode="true" />
  </Target>
</Project>