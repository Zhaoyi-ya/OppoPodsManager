<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows 后端由 RID 或构建参数决定；Linux 保持纯 net10.0。 -->
    <EnableWindowsBackend Condition="'$(EnableWindowsBackend)' == '' and $(RuntimeIdentifier.StartsWith('win'))">true</EnableWindowsBackend>
    <EnableWindowsBackend Condition="'$(EnableWindowsBackend)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</EnableWindowsBackend>
    <EnableWindowsBackend Condition="'$(EnableWindowsBackend)' == ''">false</EnableWindowsBackend>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OppoPodsManager</AssemblyName>
    <TargetFramework Condition="'$(EnableWindowsBackend)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(EnableWindowsBackend)' != 'true'">net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OppoPodsManager</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <SupportedOSPlatformVersion Condition="'$(EnableWindowsBackend)' == 'true'">10.0.19041.0</SupportedOSPlatformVersion>
    <NoWarn>CA1416;IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <!-- Linux 传输使用 BlueZ D-Bus；Windows 专属文件不参与 Linux 编译。 -->
  <PropertyGroup Condition="'$(EnableWindowsBackend)' != 'true'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableWindowsBackend)' == 'true'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableWindowsBackend)' != 'true'">
    <PackageReference Include="Tmds.DBus" Version="0.94.2" />
    <Compile Remove="Communication\Transport\Windows\**\*.cs" />
    <Compile Remove="Communication\Windows\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableWindowsBackend)' == 'true'">
    <Compile Remove="Communication\Transport\Linux\**\*.cs" />
    <Compile Remove="Communication\Linux\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="SukiUI" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Localization\Strings*.json" />
    <AvaloniaResource Include="Assets\VisualAssets\**\*" />
    <AvaloniaResource Include="Assets\Oplus\Images\*.png" />
    <EmbeddedResource Include="Assets\Oplus\Data\DeviceModels.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.DeviceModels.json" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.json" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.en.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.en.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.de.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.de.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Oplus\Data\EqModeNames.ru.json" LogicalName="OppoPodsManager.Assets.Oplus.Data.EqModeNames.ru.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Vivo\Data\DeviceModels.json" LogicalName="OppoPodsManager.Assets.Vivo.Data.DeviceModels.json" />
    <EmbeddedResource Include="Assets\Localization\Strings.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.json" />
    <EmbeddedResource Include="Assets\Localization\Strings.en.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.en.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Localization\Strings.de.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.de.json" WithCulture="false" />
    <EmbeddedResource Include="Assets\Localization\Strings.ru.json" LogicalName="OppoPodsManager.Assets.Localization.Strings.ru.json" WithCulture="false" />
  </ItemGroup>
</Project>
