<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OppoPodsManager"
             xmlns:l10n="using:OppoPodsManager.Assets.Localization"
             x:Class="OppoPodsManager.UI.Views.DeviceInfoView">
 <StackPanel Spacing="14" Margin="0,0,0,40">
  <TextBlock Text="{l10n:Translate DeviceInfo_Title}" FontSize="16"
     HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
  <!-- 耳机操控 -->
  <Border x:Name="DiTouchCard" Padding="18,16"
    CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
   <StackPanel Spacing="12">
    <Grid ColumnDefinitions="*,Auto">
     <TextBlock Text="{l10n:Translate DeviceInfo_TouchControls}" FontSize="14"
        Foreground="{DynamicResource SukiText}" Opacity="0.9"/>
     <Border Grid.Column="1" CornerRadius="9" Padding="8,2" Background="#22FFB020">
      <TextBlock Text="{l10n:Translate DeviceInfo_WIP}" FontSize="11" Foreground="#FFFFB020"/>
     </Border>
    </Grid>
    <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
     <!-- ===== 左耳 ===== -->
     <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Stretch">
      <Image x:Name="DiTouchLeftImage" Height="56" Stretch="Uniform"
        HorizontalAlignment="Center"/>
      <TextBlock Text="{l10n:Translate Battery_Left}" FontSize="13" Opacity="0.7"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_SingleTap}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchLeftClick" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_None}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_PlayPause}"/>
       </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_DoubleTap}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchLeftDouble" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_None}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_PlayPause}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_Prev}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_Next}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_VoiceAssistant}"/><ComboBoxItem Content="{l10n:Translate Feature_GameMode}"/>
       </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_TripleTap}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchLeftTriple" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_Prev}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_Next}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_VoiceAssistant}"/><ComboBoxItem Content="{l10n:Translate Feature_GameMode}"/>
       </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_Slide}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchLeftSlide" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_None}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_VolumeControl}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_SongSwitch}"/>
       </ComboBox>
      </Grid>
      <StackPanel Spacing="3" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_LongPress}" FontSize="12" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <TextBlock Text="{l10n:Translate DeviceInfo_LongPressHint}" FontSize="10" Opacity="0.45"
          Foreground="{DynamicResource SukiText}" Margin="0,0,0,2"/>
       <CheckBox x:Name="CbTouchLeftLongAnc" Content="{l10n:Translate Anc_ModeNoiseCancellation}" Margin="0,1"/>
       <CheckBox x:Name="CbTouchLeftLongAdaptive" Content="{l10n:Translate Anc_ModeAdaptive}" Margin="0,1"/>
       <CheckBox x:Name="CbTouchLeftLongTransparent" Content="{l10n:Translate Anc_ModeTransparency}" Margin="0,1"/>
       <CheckBox x:Name="CbTouchLeftLongOff" Content="{l10n:Translate Anc_ModeOff}" Margin="0,1"/>
      </StackPanel>
     </StackPanel>

     <!-- ===== 右耳 ===== -->
     <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Stretch">
      <Image x:Name="DiTouchRightImage" Height="56" Stretch="Uniform"
        HorizontalAlignment="Center"/>
      <TextBlock Text="{l10n:Translate Battery_Right}" FontSize="13" Opacity="0.7"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_SingleTap}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchRightClick" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_None}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_PlayPause}"/>
       </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_DoubleTap}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchRightDouble" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_None}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_PlayPause}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_Prev}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_Next}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_VoiceAssistant}"/><ComboBoxItem Content="{l10n:Translate Feature_GameMode}"/>
       </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_TripleTap}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchRightTriple" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_Prev}"/><ComboBoxItem Content="{l10n:Translate DeviceInfo_Next}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_VoiceAssistant}"/><ComboBoxItem Content="{l10n:Translate Feature_GameMode}"/>
       </ComboBox>
      </Grid>
      <Grid ColumnDefinitions="38,*" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_Slide}" FontSize="12" VerticalAlignment="Center" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <ComboBox x:Name="CbTouchRightSlide" Grid.Column="1" Height="26" FontSize="13" Padding="4,0">
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_None}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_VolumeControl}"/>
        <ComboBoxItem Content="{l10n:Translate DeviceInfo_SongSwitch}"/>
       </ComboBox>
      </Grid>
      <StackPanel Spacing="3" Margin="0,2">
       <TextBlock Text="{l10n:Translate DeviceInfo_LongPress}" FontSize="12" Opacity="0.6"
          Foreground="{DynamicResource SukiText}"/>
       <TextBlock Text="{l10n:Translate DeviceInfo_LongPressHint}" FontSize="10" Opacity="0.45"
          Foreground="{DynamicResource SukiText}" Margin="0,0,0,2"/>
       <CheckBox x:Name="CbTouchRightLongAnc" Content="{l10n:Translate Anc_ModeNoiseCancellation}" Margin="0,1"/>
       <CheckBox x:Name="CbTouchRightLongAdaptive" Content="{l10n:Translate Anc_ModeAdaptive}" Margin="0,1"/>
       <CheckBox x:Name="CbTouchRightLongTransparent" Content="{l10n:Translate Anc_ModeTransparency}" Margin="0,1"/>
       <CheckBox x:Name="CbTouchRightLongOff" Content="{l10n:Translate Anc_ModeOff}" Margin="0,1"/>
      </StackPanel>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
  <!-- 本机设备 / 连接策略已迁至「设置」页。隐藏的 EQ 快捷选择器（由快照驱动）保留原 MainWindow.CbEq 语义。 -->
  <ComboBox x:Name="CbEq" IsVisible="False"/>
 </StackPanel>
</UserControl>
