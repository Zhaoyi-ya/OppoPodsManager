<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OppoPodsManager"
             xmlns:l10n="using:OppoPodsManager.Assets.Localization"
             x:Class="OppoPodsManager.UI.Views.HomeView">
 <StackPanel Spacing="14" Margin="0,0,0,40">
  <Border Padding="14,10"
    CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
   <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="28">
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
     <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF5555" Margin="0,0,6,0"/>
     <TextBlock x:Name="StatusText" Text="{l10n:Translate Status_Disconnected}" FontSize="13" Foreground="#FF8888"
        VerticalAlignment="Center"/>
    </StackPanel>
     <ComboBox x:Name="CbDevice" Grid.Column="1" Height="26" FontSize="11" MinWidth="140" MaxWidth="220"
       HorizontalAlignment="Right" Margin="8,0,8,0" IsVisible="False"
       ToolTip.Tip="{l10n:Translate Status_SwitchDeviceTooltip}"/>
     <Button x:Name="BtnRefreshDevices" Grid.Column="2" Content="⟳" Height="26" Width="26" FontSize="13"
       Click="RefreshDevices_Click" Padding="0" IsVisible="False" Margin="0,0,8,0"
       ToolTip.Tip="{l10n:Translate Status_RefreshDevicesTooltip}"/>
     <Button x:Name="BtnReconnect" Grid.Column="3" Content="{l10n:Translate Status_Reconnect}" Height="26" FontSize="13"
       Click="Reconnect_Click" Padding="10,0" IsVisible="False" Classes="TextPanelButton"/>
   </Grid>
  </Border>

  <Border Padding="16,14"
    CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
   <StackPanel>
    <TextBlock Text="{l10n:Translate Battery_Title}" FontSize="14" Margin="0,0,0,6"
       HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" MinHeight="150">
     <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Image x:Name="LeftBatteryImage" Height="96" Stretch="Uniform"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="{l10n:Translate Battery_Left}" FontSize="12" Opacity="0.55"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
       <TextBlock x:Name="LeftLabel" Text="-%" FontSize="13"
          Foreground="{DynamicResource SukiText}" VerticalAlignment="Center"/>
       <Path x:Name="LeftChargeBolt" Width="10" Height="10" Stretch="Uniform"
          Fill="#4CD964" VerticalAlignment="Center" IsVisible="False"/>
      </StackPanel>
      <ProgressBar x:Name="LeftBatteryProgress" Height="4" Minimum="0" Maximum="100"
        HorizontalAlignment="Stretch" Margin="4,0" IsVisible="False"/>
     </StackPanel>

     <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Image x:Name="RightBatteryImage" Height="96" Stretch="Uniform"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="{l10n:Translate Battery_Right}" FontSize="12" Opacity="0.55"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
       <TextBlock x:Name="RightLabel" Text="-%" FontSize="13"
          Foreground="{DynamicResource SukiText}" VerticalAlignment="Center"/>
       <Path x:Name="RightChargeBolt" Width="10" Height="10" Stretch="Uniform"
          Fill="#4CD964" VerticalAlignment="Center" IsVisible="False"/>
      </StackPanel>
      <ProgressBar x:Name="RightBatteryProgress" Height="4" Minimum="0" Maximum="100"
        HorizontalAlignment="Stretch" Margin="4,0" IsVisible="False"/>
     </StackPanel>

     <StackPanel Grid.Column="2" Spacing="8" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Image x:Name="CaseBatteryImage" Height="96" Stretch="Uniform"
        HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="{l10n:Translate Battery_Case}" FontSize="12" Opacity="0.55"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
      <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
       <TextBlock x:Name="CaseLabel" Text="-%" FontSize="13"
          Foreground="{DynamicResource SukiText}" VerticalAlignment="Center"/>
       <Path x:Name="CaseChargeBolt" Width="10" Height="10" Stretch="Uniform"
          Fill="#4CD964" VerticalAlignment="Center" IsVisible="False"/>
      </StackPanel>
      <ProgressBar x:Name="CaseBatteryProgress" Height="4" Minimum="0" Maximum="100"
        HorizontalAlignment="Stretch" Margin="4,0" IsVisible="False"/>
     </StackPanel>
    </Grid>
    <TextBlock x:Name="WearStatus" Text="" FontSize="12" HorizontalAlignment="Center"
       Opacity="0.5" Margin="0,8,0,0" Foreground="{DynamicResource SukiText}"/>
   </StackPanel>
  </Border>

  <!-- ANC + 功能 并排 -->
  <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
   <Border x:Name="AncPanel" Padding="12,14" Grid.Column="0" IsVisible="True"
     CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
    <StackPanel Spacing="8">
     <TextBlock Text="{l10n:Translate Anc_Title}" FontSize="14"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
     <TextBlock x:Name="AncPlaceholderText" Text="{l10n:Translate Anc_Placeholder}" FontSize="13"
        HorizontalAlignment="Center" Opacity="0.45" Foreground="{DynamicResource SukiText}"/>
     <Grid x:Name="AncMainRow" ColumnDefinitions="Auto" HorizontalAlignment="Center"/>
     <Grid x:Name="AncSubRow" ColumnDefinitions="Auto" HorizontalAlignment="Center"/>
     <TextBlock x:Name="AncRealtimeHint" FontSize="12" Opacity="0.5" IsVisible="False"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
    </StackPanel>
   </Border>

   <Border Padding="12,14" Grid.Column="1"
     CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
    <StackPanel>
     <TextBlock Text="{l10n:Translate Feature_Title}" FontSize="14" Margin="0,0,0,6"
        HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
     <TextBlock x:Name="FeaturePlaceholderText" Text="{l10n:Translate Feature_Placeholder}" FontSize="13"
        HorizontalAlignment="Center" Opacity="0.45" Foreground="{DynamicResource SukiText}" IsVisible="True"/>
     <StackPanel x:Name="FeatureContentPanel" IsVisible="False">
      <UniformGrid Columns="2" HorizontalAlignment="Stretch" Margin="0,0,0,6">
       <CheckBox x:Name="CbDualDevice" Content="{l10n:Translate Feature_DualDevice}" Margin="0,3"/>
       <CheckBox x:Name="CbGame" Content="{l10n:Translate Feature_GameMode}" Margin="0,3"/>
       <CheckBox x:Name="CbLongPower" Content="{l10n:Translate Feature_LongPowerMode}" Margin="0,3"/>
       <CheckBox x:Name="CbWearDetection" Content="{l10n:Translate Feature_WearDetection}" Margin="0,3"/>
       <CheckBox x:Name="CbSpineHealth" Content="{l10n:Translate Feature_SpineHealth}" Margin="0,3"/>
       <CheckBox x:Name="CbSpatial" Content="{l10n:Translate Feature_SpatialSound}" Margin="0,3"/>
       <CheckBox x:Name="CbGameSound" Content="{l10n:Translate Feature_GameSound}" Margin="0,3"/>
       <CheckBox x:Name="CbBassEngine" Content="{l10n:Translate Feature_BassEngine}" Margin="0,3"/>
       <CheckBox x:Name="CbVocalEnhance" Content="{l10n:Translate Feature_VocalEnhance}" Margin="0,3"/>
       <CheckBox x:Name="CbHearingEnhance" Content="{l10n:Translate Feature_HearingEnhance}" Margin="0,3"/>
      </UniformGrid>
      <Button x:Name="BtnFindDevice" Content="{l10n:Translate Feature_FindDevice}" Height="28" FontSize="13"
          Click="BtnFindDevice_Click" Padding="18,0" IsVisible="False" Classes="TextPanelButton" HorizontalAlignment="Center"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>

  <Border x:Name="SpatialAudioPanel" IsVisible="False" Padding="16,14"
    CornerRadius="14" BoxShadow="0 1 4 0 #14000000" Classes="glassCard">
   <StackPanel Spacing="8">
    <TextBlock Text="{l10n:Translate SpatialAudio_Title}" FontSize="14"
       HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>
    <WrapPanel x:Name="SpatialAudioModes" HorizontalAlignment="Center"/>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
