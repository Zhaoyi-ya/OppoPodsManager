<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OppoPodsManager"
             xmlns:l10n="using:OppoPodsManager.Assets.Localization"
             x:Class="OppoPodsManager.UI.Views.SettingsView">
 <StackPanel Spacing="14" Margin="0,0,0,40">
  <!-- ====== 本机设备（原设备详情-基本信息） ====== -->
  <Border Padding="18,16"
    CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
   <StackPanel Spacing="10">
    <TextBlock Text="{l10n:Translate Settings_ThisDevice}" FontSize="14"
       Foreground="{DynamicResource SukiText}" Opacity="0.8"/>
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
     <TextBlock Grid.Row="0" Grid.Column="0" Text="{l10n:Translate DeviceInfo_DeviceName}" FontSize="13"
        Opacity="0.5" Foreground="{DynamicResource SukiText}" Margin="0,0,20,6"/>
     <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DiDeviceName" Text="-" FontSize="13"
        Foreground="{DynamicResource SukiText}" Margin="0,0,0,6"/>
     <TextBlock Grid.Row="1" Grid.Column="0" Text="{l10n:Translate DeviceInfo_FirmwareVersion}" FontSize="13"
        Opacity="0.5" Foreground="{DynamicResource SukiText}" Margin="0,0,20,6"/>
     <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DiFirmware" Text="-" FontSize="13"
        Foreground="{DynamicResource SukiText}" Margin="0,0,0,6"/>
     <TextBlock Grid.Row="2" Grid.Column="0" Text="{l10n:Translate DeviceInfo_Codec}" FontSize="13"
        Opacity="0.5" Foreground="{DynamicResource SukiText}"/>
     <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DiCodec" Text="-" FontSize="13"
        Foreground="{DynamicResource SukiText}"/>
    </Grid>
   </StackPanel>
  </Border>
  <Border Padding="22,20"
    CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard"
    >
   <StackPanel>
    <TextBlock Text="{l10n:Translate Settings_Title}" FontSize="16" Margin="0,0,0,16"
       HorizontalAlignment="Center" Foreground="{DynamicResource SukiText}"/>

    <Grid ColumnDefinitions="*,*">
     <!-- ====== 左列：高级设置 ====== -->
     <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="6">
      <TextBlock Text="{l10n:Translate Settings_DeviceModel}" FontSize="13"
         Foreground="{DynamicResource SukiText}" Opacity="0.7"/>
      <ComboBox x:Name="CbBrand" Height="28" Padding="8,0" HorizontalAlignment="Stretch"/>
      <ComboBox x:Name="CbSeries" Height="28" Padding="8,0" HorizontalAlignment="Stretch"/>
      <ComboBox x:Name="CbModel" Height="28" Padding="8,0" HorizontalAlignment="Stretch"/>
      <TextBlock x:Name="ModelNote" Text="" FontSize="11" Opacity="0.55"
         Margin="0,-2,0,8"/>

     </StackPanel>

     <!-- ====== 右列：工具 ====== -->
     <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="6">
      <CheckBox x:Name="CbAuto" Content="{l10n:Translate Settings_AutoStart}" Margin="0,0,0,2"/>
      <CheckBox x:Name="CbTray" Content="{l10n:Translate Settings_CloseToTray}" Margin="0,0,0,2"/>
      <CheckBox x:Name="CbAutoUpdate" Content="{l10n:Translate Settings_AutoUpdate}" Margin="0,0,0,10"/>

      <Button x:Name="BtnCheckUpdate" Content="{l10n:Translate Settings_CheckUpdate}" Height="32" FontSize="13"
          Click="BtnCheckUpdate_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4" Classes="TextPanelButton"/>
      <Button x:Name="BtnFeedback" Content="{l10n:Translate Settings_Feedback}" Height="32" FontSize="13"
          Click="BtnFeedback_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4" Classes="TextPanelButton"/>
       <Button x:Name="BtnViewLog" Content="{l10n:Translate Settings_ViewLog}" Height="32" FontSize="13"
           Click="BtnViewLog_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4" Classes="TextPanelButton"/>
       <Button x:Name="BtnRestoreHiddenDevices" Content="{l10n:Translate Settings_RestoreHiddenDevices}" Height="32" FontSize="13"
           Click="BtnRestoreHiddenDevices_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4" Classes="TextPanelButton"/>
       <Button Content="{l10n:Translate Settings_About}" Height="32" FontSize="13"
          Click="About_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4" Classes="TextPanelButton"/>
     </StackPanel>
    </Grid>
   </StackPanel>
  </Border>
  <!-- ====== 连接（原设备详情-连接策略） ====== -->
  <Border x:Name="DiConnectionStrategyCard" Padding="18,16" IsVisible="False"
    CornerRadius="14" BoxShadow="0 0 0 0 #00000000" Classes="glassCard">
   <StackPanel Spacing="10">
    <TextBlock Text="{l10n:Translate Sidebar_ConnectionStrategy}" FontSize="14"
       Foreground="{DynamicResource SukiText}" Opacity="0.8"/>
    <StackPanel x:Name="PriorityDevicePanel" IsVisible="False" Spacing="6" Margin="0" HorizontalAlignment="Stretch">
     <TextBlock Text="{l10n:Translate Sidebar_PriorityDevice}" FontSize="12" Opacity="0.6"
         Margin="0" HorizontalAlignment="Left" Foreground="{DynamicResource SukiText}"/>
     <ComboBox x:Name="CbPriorityDevice" Height="30" Padding="8,0"
         Margin="0" HorizontalAlignment="Stretch" PlaceholderText="{l10n:Translate Sidebar_AutoSelect}"/>
    </StackPanel>
   </StackPanel>
  </Border>
 </StackPanel>
</UserControl>
